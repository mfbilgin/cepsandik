# --- Project Configuration ---
GITHUB_OWNER=mfbilgin
COMPOSE_PROJECT_NAME=cepsandik

# --- Database (PostgreSQL) ---
# Services will use these credentials. 
# Make sure to use these same credentials when initializing DB if doing manual SQL.
DATABASE_USERNAME=cepsandik_user
DATABASE_PASSWORD=ChangeMeStrongPassword123!

# --- Security (JWT) ---
# User Service: app.jwt.secret
JWT_SECRET=ChangeMeChangeMeChangeMeChangeMe32Chars!
# User Service: app.jwt.access-ttl-seconds
JWT_TTL_SECONDS=900

# Community & Election Service: jwt.internal.secret
INTERNAL_JWT_SECRET=InternalSecretInternalSecretInternalSec!

# --- Message Broker (RabbitMQ) ---
RABBITMQ_USERNAME=cepsandik_mq
RABBITMQ_PASSWORD=ChangeMeMQPassword123!

# --- External Services ---
# Email (SMTP / SendGrid / Amazon SES)
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-api-key
MAIL_HOST=email-smtp.eu-central-1.amazonaws.com 
MAIL_PORT=587

# AWS S3 (User Service)
# Code uses: aws.s3.access-key, aws.s3.secret-key, aws.s3.bucket, aws.s3.region
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=eu-north-1
AWS_BUCKET=cepsandik-uploads

# --- Application Configuration ---
# User Service: app.frontend.url
FRONTEND_URL=https://cepsandik.com
# Community Service: app.invitation.link-base
INVITATION_LINK_BASE=https://cepsandik.com/join/
