# ============================================
# CepSandık Production Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# --- Project Metadata ---
COMPOSE_PROJECT_NAME=cepsandik
GITHUB_OWNER=mfbilgin

# --- Database (PostgreSQL) ---
# Shared credentials for all three databases (userdb, communitydb, electiondb)
# SECURITY: Change these to strong, unique values in production
DATABASE_USERNAME=cepsandik_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_HERE

# --- Security - JWT Tokens ---
# User Service: app.jwt.secret (for user authentication tokens)
# SECURITY: Must be at least 32 characters, use a cryptographically secure random string
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING_FOR_JWT_SECRET

# User Service: app.jwt.access-ttl-seconds (token expiry in seconds)
JWT_TTL_SECONDS=900

# Community & Election Services: jwt.internal.secret (for service-to-service communication)
# SECURITY: Must be different from JWT_SECRET
INTERNAL_JWT_SECRET=CHANGE_ME_TO_DIFFERENT_RANDOM_64_CHAR_HEX_FOR_INTERNAL

# --- Cache Layer (Redis) ---
# Redis typically runs without password in private network, but you can add one if needed
# User Service uses: spring.data.redis.password (optional, leave empty for no password)
REDIS_PASSWORD=

# --- Message Broker (RabbitMQ) ---
# User Service uses RabbitMQ for async operations
# SECURITY: Change these credentials
RABBITMQ_USERNAME=cepsandik_mq
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# --- Email Service (SMTP) ---
# User Service: spring.mail.* configuration
# For AWS SES, use SMTP endpoint and IAM credentials
MAIL_HOST=email-smtp.eu-north-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_AWS_SES_SMTP_USERNAME
MAIL_PASSWORD=YOUR_AWS_SES_SMTP_PASSWORD

# Email sender configuration
# User Service: app.mail.from and app.mail.from-name
MAIL_FROM=noreply@cepsandik.com
MAIL_FROM_NAME=CepSandık

# Email timeouts (User Service: spring.mail.properties.mail.smtp.*)
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# --- AWS S3 (File Storage) ---
# User Service: aws.s3.* configuration for profile image uploads
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-north-1
AWS_BUCKET=cepsandik-uploads

# --- Application URLs ---
# User Service: app.frontend.url (used for email links, CORS, etc.)
FRONTEND_URL=https://cepsandik.com

# Community Service: app.invitation.link-base (used for community invitation links)
INVITATION_LINK_BASE=https://cepsandik.com/join/

# --- Election Configuration ---
# Election Service: app.access-code.* configuration
ACCESS_CODE_LENGTH=6
ACCESS_CODE_CHARACTERS=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# --- Server Configuration (Optional) ---
# Your Digital Ocean Droplet IP address (for documentation/reference)
SERVER_IP=YOUR_DROPLET_IP_ADDRESS

# Domain configuration (for documentation/reference)
API_DOMAIN=api.cepsandik.com
FRONTEND_DOMAIN=cepsandik.com

# --- SSL/TLS Configuration ---
# Email for Let's Encrypt SSL certificate notifications
LETSENCRYPT_EMAIL=admin@cepsandik.com

# --- Unsplash Configuration ---
APPLICATION_ID=""
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""
